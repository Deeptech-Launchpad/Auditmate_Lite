# Auditmate Lite — copy this file to `.env` and fill in the values.
# setup.ps1 generates a .env for you automatically; this is the reference.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_DEBUG=1
# Change this to a long random string in production.
SECRET_KEY=dev-only-change-me

# --- PostgreSQL ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/auditmate_dev

# --- File storage ---
# Where uploaded documents are written. Kept outside the web root.
STORAGE_ROOT=./storage

# --- AI extraction (Claude) ---
# Leave blank to run rule-based extraction only (Excel/CSV/Word/typed PDF).
# Add a key to enable AI extraction of scanned PDFs, messy layouts, and
# AI-assisted account mapping. Get one at https://console.anthropic.com/
# Which engine reads documents the parsers cannot handle.
AI_PROVIDER=gemini

# Google AI Studio - free tier available: https://aistudio.google.com/apikey
# NOTE: the FREE tier may use submitted content to improve Google's
# products. Fine for synthetic test data; use a paid tier before
# sending real client documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic - https://console.anthropic.com/ (paid, no training on API data)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Rows scoring below this confidence are flagged for auditor review.
CONFIDENCE_THRESHOLD=0.80

# --- Background jobs ---
# 1 = run extraction inline in the web request (simple, good for demo).
# 0 = queue jobs for the separate worker.py process (production).
JOBS_INLINE=1

# --- Email: sending statements to customers and reading their replies ---
# Gmail / Google Workspace. Use a 16-character App Password, NOT your normal
# password: Google Account > Security > 2-Step Verification > App passwords.
# Also enable IMAP in Gmail Settings > Forwarding and POP/IMAP.
# Leave blank to build versions and workbooks without sending anything.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AltiusNXT Audit

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Prefix for the reference in the email subject, e.g. [AM-2025-0007]
EMAIL_TOKEN_PREFIX=AM

# --- Xero (optional) -------------------------------------------------------
# Register an app at https://developer.xero.com/app/manage
# The redirect URI must match what you registered there, character for
# character. Register both the local and the production URI on the same app.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5000/integrations/xero/callback

# Try the whole connect-and-pull flow with canned data, no credentials
# needed. Ignored the moment real credentials are set.
XERO_DEMO_MODE=false

# Encrypts stored OAuth tokens. A Xero refresh token is 60 days of standing
# access to a client's books, so it is never stored in plaintext.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from SECRET_KEY - which works, but then changing
# SECRET_KEY forces every customer to reconnect.
TOKEN_ENCRYPTION_KEY=
